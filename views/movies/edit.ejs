<!DOCTYPE html>
<html>
<head>
    <title>Edit Movie</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include("../includes/navbar") %>

    <div class="container mt-5">

        <h1>Edit Movie</h1>

        <form
            action="/movies/<%= movie._id %>?_method=PUT"
            method="POST"
            class="movie-form needs-validation"
            novalidate
        >

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input
                    type="text"
                    name="title"
                    value="<%= movie.title %>"
                    class="form-control"
                    minlength="2"
                    maxlength="120"
                    required
                >
                <div class="invalid-feedback">
                    Enter a title with at least 2 characters.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Release Year</label>
                <input
                    type="number"
                    name="releaseYear"
                    value="<%= movie.releaseYear %>"
                    class="form-control"
                    min="1888"
                    step="1"
                    required
                >
                <div class="invalid-feedback">
                    Enter a valid release year from 1888 to the current year.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Genres</label>
                <input
                    type="text"
                    name="genres"
                    value="<%= movie.genres.join(', ') %>"
                    class="form-control"
                    maxlength="200"
                >
                <div class="invalid-feedback">
                    Use comma-separated genres without empty entries.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>

                <textarea
                    name="description"
                    class="form-control"
                    rows="4"
                    minlength="10"
                    maxlength="2000"
                    required
                ><%= movie.description %></textarea>
                <div class="invalid-feedback">
                    Enter a description with at least 10 characters.
                </div>
            </div>

            <button class="btn btn-warning">
                Update Movie
            </button>

        </form>

    </div>

    <script src="/js/movieFormValidation.js"></script>
</body>
</html>
