<!DOCTYPE html>
<html>
<head>
    <title>All Movies</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <div class="container mt-5">

        <h1 class="display-4">
            MovieVerse
        </h1>

        <p class="lead">
            Browse Movies
        </p>

        <hr>

        <div class="row">

            <% for(let movie of movies) { %>

                <div class="col-md-4 mb-4">

                    <div class="card">

                        <div class="card-body">

                            <h5 class="card-title">
                                <a href="/movies/<%= movie._id %>">
                                    <%= movie.title %>
                                </a>
                            </h5>

                            <p class="card-text">
                                <%= movie.releaseYear %>
                            </p>

                        </div>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</body>
</html>